<brls:Box
    width="auto"
    height="auto"
    axis="column"
    marginBottom="12">

    <brls:Label
        id="title"
        width="auto"
        height="auto"
        fontSize="17"
        singleLine="true"/>

    <brls:Box
        width="auto"
        height="auto"
        axis="row"
        alignItems="flexStart"
        marginTop="4"
        marginBottom="8">
        <brls:Label
            id="date"
            width="auto"
            height="auto"
            fontSize="13"
            marginRight="14"/>

        <brls:Label
            id="size"
            width="auto"
            height="auto"
            fontSize="13"/>
    </brls:Box>

    <brls:Button
        height="auto"
        width="auto"
        id="download"/>
</brls:Box>
