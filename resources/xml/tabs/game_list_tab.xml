<brls:Box
    width="auto"
    height="auto"
    axis="column">

    <!-- OQB: arriba el titulo, la busqueda (si hay) y la pildora de la hora; se arma en el codigo -->
    <brls:Box
        id="head"
        width="auto"
        height="96"
        paddingBottom="16"
        axis="row"
        alignItems="center"
        paddingTop="24"
        paddingLeft="32"
        paddingRight="32"/>

    <brls:Box
        id="loading_box"
        width="auto"
        height="auto"
        justifyContent="center"
        margin="10"
        axis="row">
        <brls:ProgressSpinner
            width="30"
            height="30"
            id="loading_spinner"
            margin="10"
            size="normal"/>
        <brls:Label
            width="auto"
            height="30"
            id="loading_label"
            margin="10"/>
    </brls:Box>

    <brls:ScrollingFrame
        id="grid_scroll"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        scrollingBehavior="centered"
        grow="1.0">

        <brls:Box
            id="grid"
            width="auto"
            height="auto"
            axis="column"
            paddingTop="4"
            paddingRight="32"
            paddingBottom="20"
            paddingLeft="32"/>

    </brls:ScrollingFrame>

    <brls:Box
        id="hint_bar"
        width="auto"
        height="74"
        axis="row"/>

</brls:Box>
