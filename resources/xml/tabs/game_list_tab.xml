<brls:Box
    width="auto"
    height="auto"
    axis="column">

    <brls:Box
        id="loading_box"
        width="auto"
        height="auto"
        justifyContent="center"
        margin="10"
        axis="row">
        <brls:ProgressSpinner
            width="30"
            height="30"
            id="loading_spinner"
            margin="10"
            size="normal"/>
        <brls:Label
            width="auto"
            height="30"
            id="loading_label"
            margin="10"/>
    </brls:Box>

    <brls:ScrollingFrame
        id="grid_scroll"
        width="auto"
        height="auto"
        grow="1.0"
        paddingTop="20"
        paddingRight="30"
        paddingBottom="20"
        paddingLeft="30">
        <brls:Box
            id="grid"
            width="auto"
            height="auto"
            axis="column"/>
    </brls:ScrollingFrame>

</brls:Box>
