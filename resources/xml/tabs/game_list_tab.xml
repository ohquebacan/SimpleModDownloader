<brls:Box
    width="auto"
    height="auto"
    axis="column">

    <brls:Box
        width="auto"
        height="auto"
        axis="row"
        alignItems="center"
        paddingTop="26"
        paddingBottom="10"
        paddingLeft="40"
        paddingRight="40">

        <brls:Label
            id="head_title"
            width="auto"
            height="auto"
            fontSize="28"
            singleLine="true"/>

        <brls:Box
            id="head_search_box"
            width="auto"
            height="auto"
            axis="row"
            grow="1.0"
            marginLeft="24"
            marginRight="14"
            paddingTop="8"
            paddingBottom="8"
            paddingLeft="16"
            paddingRight="16">

            <brls:Label
                id="head_search_label"
                width="auto"
                height="auto"
                fontSize="16"
                singleLine="true"/>
        </brls:Box>

        <brls:Box
            id="head_chips_top"
            width="auto"
            height="auto"
            axis="row"/>
    </brls:Box>


    <brls:Box
        id="loading_box"
        width="auto"
        height="auto"
        justifyContent="center"
        margin="10"
        axis="row">
        <brls:ProgressSpinner
            width="30"
            height="30"
            id="loading_spinner"
            margin="10"
            size="normal"/>
        <brls:Label
            width="auto"
            height="30"
            id="loading_label"
            margin="10"/>
    </brls:Box>

    <brls:ScrollingFrame
        id="grid_scroll"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        scrollingBehavior="centered"
        grow="1.0">

        <brls:Box
            id="grid"
            width="auto"
            height="auto"
            axis="column"
            paddingTop="10"
            paddingRight="40"
            paddingBottom="20"
            paddingLeft="40"/>

    </brls:ScrollingFrame>


    <brls:Box
        id="hint_bar"
        width="auto"
        height="auto"
        axis="row"
        alignItems="center"
        paddingTop="12"
        paddingBottom="16"
        paddingLeft="40"
        paddingRight="40"/>

</brls:Box>
