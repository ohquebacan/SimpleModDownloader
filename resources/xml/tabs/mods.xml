<brls:Box
    width="auto"
    height="auto"
    axis="column">

    <brls:Box
        id="mod_chips"
        width="auto"
        height="auto"
        axis="row"
        paddingTop="16"
        paddingLeft="30"
        paddingRight="30"/>

    <brls:ScrollingFrame
        id="mod_scroll"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        scrollingBehavior="centered"
        grow="1.0">

        <brls:Box
            id="mod_grid"
            width="auto"
            height="auto"
            axis="column"
            paddingTop="16"
            paddingRight="30"
            paddingBottom="20"
            paddingLeft="30"/>

    </brls:ScrollingFrame>

</brls:Box>
