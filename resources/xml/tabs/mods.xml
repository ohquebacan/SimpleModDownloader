<brls:Box
    width="auto"
    height="auto"
    axis="column">

    <!-- OQB: arriba el orden en una pildora, el juego y la hora; se arma en el codigo -->
    <brls:Box
        id="mhead"
        width="auto"
        height="96"
        paddingBottom="16"
        axis="row"
        alignItems="center"
        paddingTop="24"
        paddingLeft="32"
        paddingRight="32"/>

    <brls:ScrollingFrame
        id="mod_scroll"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        scrollingBehavior="centered"
        grow="1.0">

        <brls:Box
            id="mod_grid"
            width="auto"
            height="auto"
            axis="column"
            paddingTop="4"
            paddingRight="32"
            paddingBottom="20"
            paddingLeft="32"/>

    </brls:ScrollingFrame>

    <brls:Box
        id="mod_hint_bar"
        width="auto"
        height="74"
        axis="row"/>

</brls:Box>
