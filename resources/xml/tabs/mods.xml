<brls:Box
    width="auto"
    height="auto"
    axis="column">

    <brls:Box
        width="auto"
        height="auto"
        axis="row"
        alignItems="center"
        paddingTop="26"
        paddingBottom="10"
        paddingLeft="40"
        paddingRight="40">

        <brls:Label
            id="mhead_title"
            width="auto"
            height="auto"
            fontSize="28"
            singleLine="true"/>

        <brls:Box
            id="mhead_search_box"
            width="auto"
            height="auto"
            axis="row"
            grow="1.0"
            marginLeft="24"
            marginRight="14"
            paddingTop="8"
            paddingBottom="8"
            paddingLeft="16"
            paddingRight="16">

            <brls:Label
                id="mhead_search_label"
                width="auto"
                height="auto"
                fontSize="16"
                singleLine="true"/>
        </brls:Box>

        <brls:Box
            id="mhead_chips_top"
            width="auto"
            height="auto"
            axis="row"/>
    </brls:Box>


    <brls:Box
        id="mod_chips"
        width="auto"
        height="auto"
        axis="row"
        paddingTop="2"
        paddingLeft="40"
        paddingRight="40"/>

    <brls:ScrollingFrame
        id="mod_scroll"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        scrollingBehavior="centered"
        grow="1.0">

        <brls:Box
            id="mod_grid"
            width="auto"
            height="auto"
            axis="column"
            paddingTop="16"
            paddingRight="40"
            paddingBottom="20"
            paddingLeft="40"/>

    </brls:ScrollingFrame>


    <brls:Box
        id="mod_hint_bar"
        width="auto"
        height="auto"
        axis="row"
        alignItems="center"
        paddingTop="12"
        paddingBottom="16"
        paddingLeft="40"
        paddingRight="40"/>

</brls:Box>
