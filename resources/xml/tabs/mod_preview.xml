<brls:Box
    width="auto"
    height="auto"
    axis="column">

    <brls:Box
        width="auto"
        height="auto"
        axis="row"
        alignItems="center"
        paddingTop="26"
        paddingBottom="14"
        paddingLeft="40"
        paddingRight="40">

        <brls:Label
            id="mod_preview_title"
            width="auto"
            height="auto"
            fontSize="30"
            singleLine="true"/>

        <brls:Label
            id="author"
            width="auto"
            height="auto"
            fontSize="18"
            marginLeft="16"
            singleLine="true"/>

        <brls:Box
            width="auto"
            height="auto"
            grow="1.0"/>

        <brls:Label
            id="installed_label"
            width="auto"
            height="auto"
            fontSize="16"
            singleLine="true"/>
    </brls:Box>

    <brls:Box
        width="auto"
        height="auto"
        axis="row"
        grow="1.0"
        paddingLeft="40"
        paddingRight="40"
        paddingBottom="16">

        <brls:Box
            id="screenshots_box"
            width="660"
            height="auto"
            axis="column">

            <brls:Box
                id="big_image_box"
                width="auto"
                height="auto"
                marginBottom="10"/>
        </brls:Box>

        <brls:ScrollingFrame
            id="mod_preview_scrolling"
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            scrollingBehavior="centered"
            grow="1.0">

            <brls:Box
                width="auto"
                height="auto"
                axis="column"
                paddingLeft="24">

                <brls:Box
                    id="stats_box"
                    width="auto"
                    height="auto"
                    axis="row"
                    marginBottom="14"/>

                <brls:Label
                    id="description"
                    width="auto"
                    height="auto"
                    fontSize="16"
                    singleLine="false"
                    marginBottom="16"/>

                <brls:Label
                    id="files_title"
                    width="auto"
                    height="auto"
                    fontSize="15"
                    singleLine="true"
                    marginBottom="6"/>

                <brls:Box
                    id="files_box"
                    width="auto"
                    height="auto"
                    axis="column"/>

                <brls:Label
                    id="install_path"
                    width="auto"
                    height="auto"
                    fontSize="14"
                    singleLine="false"
                    marginTop="10"/>
            </brls:Box>
        </brls:ScrollingFrame>
    </brls:Box>
</brls:Box>
